#!/bin/sh
# Hook commit-msg: memastikan pesan commit tidak membawa baris atribusi alat AI, sehingga daftar kontributor
# repositori hanya berisi penulis sebenarnya. Aktifkan sekali dengan:  git config core.hooksPath .githooks
# Baris yang dibuang: "Co-Authored-By: Claude ...", "Generated with Claude Code", dan "Claude-Session: ...".
msg="$1"
tmp="$msg.tmp"
grep -v -i -E '^(co-authored-by:.*(claude|anthropic)|.*generated with \[?claude code|claude-session:)' "$msg" > "$tmp" || true
mv "$tmp" "$msg"
exit 0
